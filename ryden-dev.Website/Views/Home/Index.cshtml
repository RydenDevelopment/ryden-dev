<div id="contact" class="anchor-offset"></div>
<div class="row mb-5 text-center">
    <div class="col-sm-12 offset-md-1 col-md-10 offset-lg-2 col-lg-8 offset-xl-3 col-xl-6">
        <h2>Want to get in touch?</h2>
        <div class="info-card p-4" style="text-align: left;">
            @using (Html.BeginForm("Index", "Home", FormMethod.Post))
            {
                <label for="subject">Subject:</label>
                <div id="subject" class="row" style="margin: 0">
                    <div class="col-md-4 form-check">
                        <input class="form-check-input" type="radio" name="ContactType" id="radio-services" value="Services" checked>
                        <label class="form-check-label" for="radio-services">
                            Our Services
                        </label>
                    </div>
                    <div class="col-md-4 form-check">
                        <input class="form-check-input" type="radio" name="ContactType" id="radio-availability" value="Availability">
                        <label class="form-check-label" for="radio-availability">
                            Availability
                        </label>
                    </div>
                    <div class="col-md-4 form-check">
                        <input class="form-check-input" type="radio" name="ContactType" id="radio-pricing" value="Pricing">
                        <label class="form-check-label" for="radio-pricing">
                            Pricing
                        </label>
                    </div>
                </div>
                <br/>
                <label for="Name">Name <span class="required-form-text">*</span></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <span class="bi bi-person"></span>
                    </span>
                    <input type="text" class="form-control" id="Name" name="Name" placeholder="Enter your name" value="@Model.Name">
                    <input type="text" class="form-control" id="LastName" name="LastName" placeholder="Enter your last name" value="@Model.LastName" hidden="hidden">
                </div>
                <br/>
                <label for="Email">Email <span class="required-form-text">*</span></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <span class="bi bi-envelope"></span>
                    </span>
                    <input type="email" class="form-control" id="Email" name="Email" placeholder="Ex: your@email.com" value="@Model.Email">
                </div>
                <br/>
                <label for="PhoneNumber">Phone number</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <span class="bi bi-telephone"></span>
                    </span>
                    <input type="number" class="form-control" id="PhoneNumber" name="PhoneNumber" placeholder="Ex: +46 70 123 45 67" value="@Model.PhoneNumber">
                </div>
                <br/>
                <label for="Message">Message <span class="required-form-text">*</span></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <span class="bi bi-justify-left"></span>
                    </span>
                    <textarea class="form-control" id="Message" name="Message" rows="6" placeholder="Enter your message here, please be as specific as possible.">@Model.Message</textarea>
                </div>
                <br/>
                <div class="row">
                    <div class="col-lg-3 col-md-4 col-sm-12">
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>
                    <div class="col-lg-9 col-md-8 col-sm-12">
                        @if (!string.IsNullOrEmpty(isSuccess) && !string.IsNullOrEmpty(message))
                        {
                            <div class="alert @(isSuccess == "true" ? "alert-success" : "alert-danger") fade show" role="alert">
                                <strong>@message</strong>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<div id="bottom" class="anchor-offset"></div>