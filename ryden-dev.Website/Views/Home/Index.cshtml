@model ContactViewModel
@{
    ViewData["Title"] = "Start";
    var isSuccess = TempData["result"] as string;
    var message = TempData["message"] as string;
    var anchorValue = TempData["AnchorValue"] as string;
}
@Html.Hidden("AnchorId", anchorValue)

<!-- Hero Section -->
<header class="hero-section">
    <div class="container text-center pt-4">
        <h1 class="display-3 fw-800 mb-4">Sluta oroa dig för din hemsida</h1>
        <p class="lead mb-5 opacity-75">Vi tar hand om all teknik så att du kan fokusera på det du är bra på. <br/>Azure-hosting för svenska småföretag.</p>
        <div class="offer-card offset-3 col-lg-6">
            <div class="row align-items-center">
                <div class="col-lg-1 offset-2">
                    <i class="fa-solid fa-truck-arrow-right" style="color: #0078d4"></i>
                </div>
                <div class="col-lg-9 offer-card-text align-content-start">
                    <strong>JUST NU: Byt till oss utan kostnad</strong> <br/>
                    Vi migrerar din befintliga sida gratis (värde ca 1999 kr)!
                </div>
            </div>
        </div>
        <br/>
        <div class="d-flex justify-content-center gap-3">
            <a href="#tjanster" class="btn btn-light btn-lg px-4">Se tjänster</a>
            <a href="#priser" class="btn btn-outline-light btn-lg px-4">Visa priser</a>
        </div>
    </div>
</header>

<!-- Om företaget -->
<div id="om" class="anchor"></div>
<section class="section-padding">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="fw-bold mb-4">Din tekniska partner i molnet</h2>
                <p class="text-muted">Rydén Development drivs av en erfarna systemutvecklare med passion för modern infrastruktur. Vi specialiserar oss på att flytta mindre företags hemsidor till Microsoft Azure för att garantera maximal säkerhet och blixtsnabba laddtider.</p>
                <p class="text-muted">Istället för krångliga kontrollpaneler sköter vi allt det tekniska åt dig, så att du kan fokusera på det du gör bäst, din kärnverksamhet.</p>
            </div>
            <div class="col-lg-6 text-center">
                <div class="p-5 bg-light rounded-4">
                    <i class="fa-solid fa-cloud fa-5xl text-primary opacity-25" style="font-size: 8rem;"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Tjänster -->
<div id="tjanster" class="anchor"></div>
<section class="section-padding bg-light rounded-4">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Varför välja oss?</h2>
            <p class="text-muted">Vi levererar stabilitet i världsklass genom Microsoft Azure.</p>
        </div>
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="service-card">
                    <div class="icon-box mx-auto"><i class="fa-solid fa-bolt"></i></div>
                    <h4>Hög prestanda</h4>
                    <p class="text-muted">Blixtsnabba laddtider tack vare Azures globala infrastruktur och SSD-lagring.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card">
                    <div class="icon-box mx-auto"><i class="fa-solid fa-lock"></i></div>
                    <h4>Säkerhet i fokus</h4>
                    <p class="text-muted">SSL ingår alltid och vi skyddar din hemsida mot intrång och DDoS-attacker.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card">
                    <div class="icon-box mx-auto"><i class="fa-solid fa-headset"></i></div>
                    <h4>Personlig support</h4>
                    <p class="text-muted">Prata direkt med en utvecklare istället för en supportkö. Vi känner din lösning.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Prissättning -->
<div id="priser" class="anchor"></div>
<section class="section-padding">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Våra Hostingpaket</h2>
            <p class="text-muted">Välj den nivå som passar din verksamhet bäst.</p>
        </div>
        <div class="row g-4 justify-content-center">
            
            <!-- Startpaket -->
            <div class="col-md-4">
                <div class="card pricing-card h-100 p-4 text-center">
                    <div class="card-body d-flex flex-column">
                        <h5 class="text-uppercase text-muted fw-bold">Start</h5>
                        <p class="small text-muted">Din webbplats i trygga händer - vi sköter driften så att du slipper tänka på det.</p>
                        <div class="my-4">
                            <span class="price-tag">699:-</span>
                            <div class="price-moms">kr/mån ex moms</div>
                        </div>
                        <ul class="list-unstyled my-4 text-start flex-grow-1 pricing-list">
                            <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> För statiska sidor</li>
                            <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> Azure Hosting (99,9% SLA)</li>
                            <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> Domänhantering ingår</li>
                            <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> SSL-certifikat ingår</li>
                            <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> Support via e-post</li>
                        </ul>
                        <a href="#kontakt" class="btn btn-outline-primary w-100 mt-auto select-product" data-product="Start">Välj START</a>
                    </div>
                </div>
            </div>

            <!-- Medelpaket -->
            <div class="col-md-4">
                <div class="card pricing-card featured h-100 p-4 text-center">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-2"><span class="badge bg-primary px-3 py-2">MEST PRISVÄRD</span></div>
                        <h5 class="text-uppercase text-muted fw-bold">Tillväxt</h5>
                        <p class="small text-muted">För dig med en dynamisk webbplats som behöver aktivt underhåll och löpande uppdateringar.</p>
                        <div class="my-4">
                            <span class="price-tag">999:-</span>
                            <div class="price-moms">kr/mån ex moms</div>
                        </div>
                        <ul class="list-unstyled my-4 text-start flex-grow-1 pricing-list">
                            <li class="mb-2"><i class="fa-solid fa-plus text-primary me-2"></i> Allt i Start-paketet</li>
                            <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> Dynamiska sidor & Databaser</li>
                            <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> Backupp varje vecka</li>
                            <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> Hanterar större volymer</li>
                            <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> Prioriterad support via epost</li>
                        </ul>
                        <a href="#kontakt" class="btn btn-primary btn-azure w-100 mt-auto select-product" data-product="Företag">Välj TILLVÄXT</a>
                    </div>
                </div>
            </div>

            <!-- Större företag -->
            <div class="col-md-4">
                <div class="card pricing-card h-100 p-4 text-center">
                    <div class="card-body d-flex flex-column">
                        <h5 class="text-uppercase text-muted fw-bold">Partner</h5>
                        <p class="small text-muted">Vi är din IT-avdelning - du fokuserar på din verksamhet, vi tar hand om resten.</p>
                        <div class="my-4">
                            <span class="price-tag">1499:-</span>
                            <div class="price-moms">kr/mån ex moms</div>
                        </div>
                        <ul class="list-unstyled my-4 text-start flex-grow-1 pricing-list">
                            <li class="mb-2"><i class="fa-solid fa-plus text-primary me-2"></i> Allt i Tillväxt-paketet</li>
                            <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> SEO-Optimering</li>
                            <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> Månadsrapport</li>
                            <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> Gör mindre uppdateringar av sidan</li>
                            <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> Dedikerad kontaktperson att ringa</li>
                        </ul>
                        <a href="#kontakt" class="btn btn-outline-primary w-100 mt-auto select-product" data-product="Enterprise">Bli PARTNER</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- TILLÄGGSTJÄNSTER -->
        <div class="mt-5">
            <div class="text-center mb-4">
                <h4 class="fw-bold">Tilläggstjänster</h4>
                <p class="text-muted small">Specialanpassade lösningar för din verksamhet</p>
            </div>
            <div class="row g-4">
                <!-- Addon 1: Email and Calendar -->
                <div class="col-md-4">
                    <div class="addon-card d-flex flex-column">
                        <div class="icon-box mb-3" style="width: 50px; height: 50px;">
                            <i class="fa-solid fa-envelope"></i>
                        </div>
                        <h6 class="fw-bold">Företagsmail</h6>
                        <p class="small text-muted flex-grow-1">Professionell e-post med ditt domännamn. Vi sätter upp allt, du loggar bara in.</p>
                        <span class="fw-bold text-primary mt-2">99kr/Användare (ex moms)</span>
                    </div>
                </div>
                <!-- Addon 2: Cloud Services -->
                <div class="col-md-4">
                    <div class="addon-card d-flex flex-column">
                        <div class="icon-box mb-3" style="width: 50px; height: 50px; background-color: rgba(13, 110, 253, 0.1);">
                            <i class="fa-solid fa-envelopes-bulk"></i>
                        </div>
                        <h6 class="fw-bold">Molntjänster</h6>
                        <p class="small text-muted flex-grow-1">Ett komplett molnpaket för hela företaget. Proton Business Suite ger dig allt du behöver, utan att din data hamnar utanför Europa.</p>
                        <span class="fw-bold text-primary mt-2">199kr/Användare (ex moms)</span>
                    </div>
                </div>
                <!-- Addon 2: Cloud Services -->
                <div class="col-md-4">
                    <div class="addon-card d-flex flex-column">
                        <div class="icon-box mb-3" style="width: 50px; height: 50px; background-color: rgba(13, 110, 253, 0.1);">
                            <i class="fa-solid fa-code"></i>
                        </div>
                        <h6 class="fw-bold">Ny Hemsida från grunden</h6>
                        <p class="small text-muted flex-grow-1">Passa på att fräsha upp din sida med en ny design, där nya uppdateringar ingår som håller den aktuell och levande.</p>
                        <span class="fw-bold text-primary mt-2">999kr/mån (12 månader bindningstid, ex moms)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Kontakt -->
<div id="kontakt" class="anchor"></div>
<section class="section-padding bg-light rounded-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="row text-center">
                <h2>Kom igång redan idag?</h2>
                <div class="info-card p-4" style="text-align: left;">
                    @using (Html.BeginForm("Index", "Home", FormMethod.Post))
                    {
                        <label for="subject">Ämne:</label>
                        <div id="subject" class="row" style="margin: 0">
                            <div class="col-md-4 form-check">
                                <input class="form-check-input" type="radio" name="ContactType" id="radio-services" value="Services" checked>
                                <label class="form-check-label" for="radio-services">
                                    Beställ
                                </label>
                            </div>
                            <div class="col-md-4 form-check">
                                <input class="form-check-input" type="radio" name="ContactType" id="radio-availability" value="Availability">
                                <label class="form-check-label" for="radio-availability">
                                    Frågor kring tjänsten
                                </label>
                            </div>
                            <div class="col-md-4 form-check">
                                <input class="form-check-input" type="radio" name="ContactType" id="radio-pricing" value="Pricing">
                                <label class="form-check-label" for="radio-pricing">
                                    Frågor kring priset
                                </label>
                            </div>
                        </div>

                        <div id="product-selection-container">
                            <br/>
                            <label for="ProductName">Välj paket:</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fa-solid fa-box"></i>
                                </span>
                                <select class="form-select" id="ProductName" name="ProductName">
                                    <option value="Start" selected>Start</option>
                                    <option value="Företag">Företag</option>
                                    <option value="Enterprise">Enterprise</option>
                                </select>
                            </div>
                        </div>

                        <br/>
                        <label for="Name">Namn <span class="required-form-text">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <span class="bi bi-person"></span>
                            </span>
                            <input type="text" class="form-control" id="Name" name="Name" placeholder="Förnamn och Efternamn" value="@Model.Name">
                            <input type="text" class="form-control" id="LastName" name="LastName" placeholder="Enter your last name" value="@Model.LastName" hidden="hidden">
                        </div>
                        <br/>
                        <label for="Email">E-mail <span class="required-form-text">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <span class="bi bi-envelope"></span>
                            </span>
                            <input type="email" class="form-control" id="Email" name="Email" placeholder="Tex: your@email.com" value="@Model.Email">
                        </div>
                        <br/>
                        <label for="PhoneNumber">Telefonnummer</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <span class="bi bi-telephone"></span>
                            </span>
                            <input type="tel" class="form-control" id="PhoneNumber" name="PhoneNumber" placeholder="Tex: +46 70 123 45 67" value="@Model.PhoneNumber">
                        </div>
                        <br/>
                        <label for="Message">Ytterligare information<span class="required-form-text">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <span class="bi bi-justify-left"></span>
                            </span>
                            <textarea class="form-control" id="Message" name="Message" rows="6" placeholder="Vill du inkludera ytterligare information så kan du göra detta här. Var gärna så specifik som möjligt så återkommer vi snart det bara går.">@Model.Message</textarea>
                        </div>
                        <br/>
                        <div class="row">
                            <div class="col-lg-3 col-md-4 col-sm-12">
                                <button type="submit" class="btn btn-primary">Submit</button>
                            </div>
                            <div class="col-lg-9 col-md-8 col-sm-12">
                                @if (!string.IsNullOrEmpty(isSuccess) && !string.IsNullOrEmpty(message))
                                {
                                    <div class="alert @(isSuccess == "true" ? "alert-success" : "alert-danger") fade show" role="alert">
                                        <strong>@message</strong>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>